<UserControl x:Class="OrbitransReshetnev.View.PaymentoOrder"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:OrbitransReshetnev.ViewModel"
             mc:Ignorable="d" 
             d:DesignHeight="572" d:DesignWidth="844">

    <UserControl.DataContext>
        <vm:PaymentOrderMV />
    </UserControl.DataContext>

    <Grid>
        <Border CornerRadius="0,15,15,0" Background="#EDEDED">
            <Image Source="/Images/astronaut 1.png" Stretch="Uniform" 
                   HorizontalAlignment="Right" 
                   VerticalAlignment="Bottom" 
                   Height="408" Width="454"/>
        </Border>
        <StackPanel Orientation="Vertical">
            <Border Width="759" Height="153" Background="#FFFFFF">
                <Border.Clip>
                    <RectangleGeometry RadiusX="10" RadiusY="10" Rect="0,0,759,153"/>
                </Border.Clip>
                <Grid>
                    <StackPanel>
                        <TextBlock Text="Платежные поручения"
                                   FontFamily="Square721 BdEx BT [Rus by me]"
                                   Foreground="#000000"
                                   FontSize="24"
                                   Margin="20,30,200,0"
                                   TextWrapping="Wrap"/>
                        <Button Content="Назад"
                                Style="{StaticResource MainWindowButtonStyle}"
                                Width="100" Height="40" Margin="20,20,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
